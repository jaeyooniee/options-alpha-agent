# Never commit real credentials. Paper trading is the only supported mode.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Leave this empty when using the default Featherless provider.
OPENAI_API_KEY=
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=mistralai/Mistral-Large-Instruct-2411
AI_PROVIDER=featherless
OPENAI_MODEL=gpt-5-mini

# AI calls are bounded and audited. Prices match the default model and must be
# updated if FEATHERLESS_MODEL changes.
AI_TIMEOUT_SECONDS=30
AI_MAX_INPUT_CHARS=20000
AI_MAX_OUTPUT_TOKENS=600
AI_MAX_DAILY_CALLS=200
AI_MAX_DAILY_COST_USD=2.50
AI_INPUT_COST_PER_MILLION_USD=0.125
AI_OUTPUT_COST_PER_MILLION_USD=1.15
MIN_AI_CONFIDENCE=0.65
AI_AUDIT_LOG_PATH=logs/ai-decisions.jsonl

# Optional Cloud Run durability. `local` is the safe default. When switching to
# `gcs`, give the worker service account write access and the dashboard service
# account read access only; never put a service-account key file in this repo.
DURABLE_STATE_BACKEND=local
GCS_STATE_BUCKET=
GCS_AUDIT_OBJECT=options-alpha/audit/ai-decisions.jsonl
GCS_LOCK_OBJECT=options-alpha/locks/shadow-cycle.json
GCS_LOCK_TTL_SECONDS=900

# Safety defaults. Execution stays off until validation is complete.
ALPACA_PAPER=true
TRADE_EXECUTION_ENABLED=false
PAPER_ORDER_APPROVED=false
TRADING_KILL_SWITCH=true
WORKER_LOCK_PATH=logs/shadow-cycle.lock
STARTING_EQUITY_USD=100000
MAX_RISK_PER_TRADE_PCT=0.02
MAX_PORTFOLIO_RISK_PCT=0.10
MAX_DAILY_DRAWDOWN_PCT=0.04
MAX_OPEN_POSITIONS=5
